SIGNAL_ACCOUNT=
# One Signal number or group id, or several separated by commas.
SIGNAL_RECIPIENT=
GITHUB_WEBHOOK_SECRET=
WEBHOOK_PATH=
TUNNEL_TOKEN=
# Optional. Replaces WEBHOOK_PATH and GITHUB_WEBHOOK_SECRET. See routes.example.json
# for GitLab, Uptime Kuma, Diun, Forgejo, Woodpecker, and borgmatic.
# Kuma additional header: Authorization: Bearer <KUMA_TOKEN>
# Diun: method POST, header authorization: Bearer <DIUN_TOKEN>
# Forgejo secret is checked against X-Hub-Signature-256. Send push events.
# Woodpecker plugins/webhook. Gate the step with when.status and put that word in the body;
# the plugin's build.status value stays "success".
# {"repo":"{{ repo.owner }}/{{ repo.name }}","status":"failure","branch":"{{ build.branch }}","message":"{{ build.message }}","author":"{{ build.author }}","url":"{{ build.link }}"}
# Repeat the step with when.status success and "status":"success".
# borgmatic curl body: {"status":"success","repository":"{repository}"}
# or {"status":"error","repository":"{repository}","message":"{error}"}
# with header Authorization: Bearer <BORGMATIC_TOKEN>
# ROUTES_FILE=
